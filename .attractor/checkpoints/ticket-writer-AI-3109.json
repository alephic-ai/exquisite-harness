    "ticketWriter.request": "{\"candidates\":[{\"acceptanceCriteria\":[\"When plan.env owns apiKeyEnvKey with a blank value, gatewayValidationHeaders skips the ambient process.env fallback and uses the plan's ANTHROPIC_AUTH_TOKEN.\",\"A gateway-routing test can keep an ambient ANTHROPIC_API_KEY set and still resolve validation auth to the plan's auth token.\"],\"canonicalDuplicateKey\":\"alephic-ai-exquisite-harness-gatewayvalidationheaders-blank-plan-key-vs-ambient-env-precedence\",\"finding\":\"A plan that deliberately blanks its provider key (plan.env[apiKeyEnvKey]='') still falls through to the ambient shell value before the plan's ANTHROPIC_AUTH_TOKEN, so validation can authenticate with a credential the child never sees (the child runs with { ...process.env, ...plan.env }, where the blank plan value overrides the ambient one).\",\"id\":\"follow-up-1\",\"impact\":\"Gateway provider validation can use a different token than the spawned child, so validation may pass or fail against the wrong credential when a config supplies an auth token instead of a provider API key.\",\"repoScope\":\"alephic-ai/exquisite-harness\",\"sourceArtifact\":\".attractor/review-codex.md\",\"sourceLocation\":{\"description\":\"gatewayValidationHeaders ranks the ambient process.env[apiKeyEnvKey] ahead of the plan's ANTHROPIC_AUTH_TOKEN, even when plan.env owns apiKeyEnvKey with a deliberately blank value.\",\"file\":\"src/gateway-routing.ts\",\"line\":238},\"sourceReviewer\":\"codex\",\"suggestedTitle\":\"Treat a deliberately-blank plan provider key as authoritative in gatewayValidationHeaders\",\"verificationCommands\":[\"bun test src/gateway-routing.test.ts\",\"pnpm test\"],\"whyDeferred\":\"gatewayValidationHeaders is pre-existing and untouched by AI-3109 — this PR only made the gateway-routing test hermetic against a leaked ambient ANTHROPIC_API_KEY; changing header precedence is outside the reserved-exit-codes scope.\"}],\"depth\":1,\"kind\":\"review-follow-up\",\"requestId\":\"review-follow-up-ai-3109-pr-49\",\"source\":{\"parentTicketId\":\"AI-3109\",\"pr\":{\"branch\":\"intelligencev2/ai-3109-eh-run-reserved-exit-codes-for-eh-detected-failure\",\"number\":49,\"url\":\"https://github.com/alephic-ai/exquisite-harness/pull/49\"}},\"summary\":\"Review follow-ups for AI-3109 / PR #49\",\"version\":1}"
